# Postgres (Railway injects DATABASE_URL when you attach a Postgres plugin)
DATABASE_URL=postgresql+asyncpg://finder:finder@localhost:5432/finder

# Verifier API keys — never commit real values
MILLIONVERIFIER_API_KEY=
NO2BOUNCE_API_KEY=

# Run controls
# Domain fan-out. Default 10, hard cap 20.
MAX_CONCURRENCY=10
# Per-vendor HTTP in-flight caps (independent of MAX_CONCURRENCY).
VERIFIER_MAX_CONCURRENCY=8
HUNTER_MAX_CONCURRENCY=5
DEFAULT_COST_CEILING=25.00

# Optional: path to YAML config (defaults to ./config/finder.yaml)
# FINDER_CONFIG=./config/finder.yaml

# Optional: sqlite for local/dev without Postgres
# DATABASE_URL=sqlite+aiosqlite:///./finder.db

# Hunter domain search. Missing key falls back to local inference.
HUNTER_API_KEY=
MAX_HUNTER_CALLS=200

# Optional permanent pattern cache (Supabase project azpapwtnrbzywlnxxecz)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
